<%- include('partials/header', { title: 'Cleaning Services — Elite Shining Cleaning Australia' }) %>

<section class="bg-gradient-to-br from-brand-800 to-brand-950 text-white py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/20 px-4 py-1.5 text-sm font-medium">Our Services</span>
        <h1 class="mt-5 font-display font-extrabold text-4xl sm:text-5xl">Premium Cleaning, Tailored to You</h1>
        <p class="mt-5 text-brand-100 max-w-2xl mx-auto">Whether it's a weekly refresh, a full bond clean, or your office space — our vetted, insured cleaners deliver a spotless result every time.</p>
    </div>
</section>

<section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        <% services.forEach(function (service, i) { %>
            <div class="reveal grid lg:grid-cols-2 gap-10 items-center <%= i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : '' %>">
                <div class="relative">
                    <div class="group relative overflow-hidden rounded-[2.5rem] hover-lift aspect-[4/3] shadow-card">
                        <img src="<%= service.image ? asset(service.image) : asset('images/hero-cleaning.jpg') %>" alt="<%= service.title %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
                        <div class="absolute inset-0 bg-gradient-to-t from-brand-950/40 via-transparent to-transparent"></div>
                    </div>
                    <% if (service.badge_text) { %>
                        <div class="absolute -bottom-5 <%= i % 2 === 1 ? 'lg:-right-5 -left-5 lg:left-auto' : '-left-5' %> bg-white rounded-2xl shadow-card px-5 py-3 border border-slate-100 hover-lift">
                            <p class="text-xs text-slate-400">Why it works</p>
                            <p class="font-display font-bold text-brand-700 text-sm whitespace-nowrap"><%= service.badge_text %></p>
                        </div>
                    <% } %>
                </div>
                <div>
                    <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-slate-900"><%= service.title %></h2>
                    <p class="mt-4 text-slate-500"><%= service.description %></p>
                    <ul class="mt-6 space-y-3">
                        <% featuresList(service.features).forEach(function (f) { %>
                            <li class="flex items-center gap-3 text-sm text-slate-600">
                                <span class="w-5 h-5 rounded-full bg-brand-500 text-white flex items-center justify-center text-xs font-bold">✓</span>
                                <%= f %>
                            </li>
                        <% }) %>
                    </ul>
                    <a href="/contact" class="btn-glow mt-6 inline-flex items-center gap-2 rounded-full bg-brand-600 hover:bg-brand-700 px-6 py-3 text-white font-semibold shadow-soft hover:-translate-y-0.5 hover:shadow-lg transition-all">Get a Quote →</a>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<section class="py-16 bg-gradient-to-r from-brand-600 to-brand-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <h2 class="font-display font-extrabold text-3xl">Not sure which service you need?</h2>
        <p class="mt-3 text-brand-100">Chat with our team and we'll recommend the best plan for your space and budget.</p>
        <a href="/contact" class="mt-8 inline-flex items-center gap-2 rounded-full bg-gold-400 hover:bg-gold-500 px-8 py-4 text-brand-950 font-bold shadow-soft transition">Talk to Us →</a>
    </div>
</section>

<%- include('partials/footer', { footerServices: footerServices }) %>
