<%- include('partials/header', { title: 'FAQ — Elite Shining Cleaning Australia' }) %>

<section class="bg-gradient-to-br from-brand-800 to-brand-950 text-white py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/20 px-4 py-1.5 text-sm font-medium">FAQ</span>
        <h1 class="mt-5 font-display font-extrabold text-4xl sm:text-5xl">Frequently Asked Questions</h1>
    </div>
</section>

<section class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" x-data="{ openIndex: 0 }">
        <% faqs.forEach(function (faq, i) { %>
            <div class="border rounded-2xl shadow-card overflow-hidden transition-colors duration-300" :class="openIndex === <%= i %> ? 'border-brand-300' : 'border-slate-100'">
                <button @click="openIndex === <%= i %> ? openIndex = null : openIndex = <%= i %>"
                    class="w-full flex items-center justify-between gap-4 px-6 py-5 text-left font-semibold text-slate-900 hover:bg-slate-50 transition">
                    <%= faq.question %>
                    <span class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-lg font-bold transition-all duration-300" :class="openIndex === <%= i %> ? 'bg-brand-600 text-white rotate-180' : 'bg-brand-50 text-brand-600'" x-text="openIndex === <%= i %> ? '−' : '+'"></span>
                </button>
                <div x-show="openIndex === <%= i %>" x-transition x-cloak class="px-6 pb-5 text-sm text-slate-500 leading-relaxed">
                    <%= faq.answer %>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<section class="py-16 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display font-extrabold text-2xl text-slate-900">Still have questions?</h2>
        <p class="mt-3 text-slate-500">Our friendly team is here to help, 7 days a week.</p>
        <a href="/contact" class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-600 hover:bg-brand-700 px-7 py-3.5 text-white font-semibold shadow-soft transition">Contact Us →</a>
    </div>
</section>

<%- include('partials/footer', { footerServices: footerServices }) %>
