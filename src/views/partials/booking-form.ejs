<div class="<%= typeof compact !== 'undefined' && compact ? '' : 'bg-white rounded-3xl shadow-soft p-6 sm:p-8 border border-slate-100' %>">
    <% if (success) { %>
        <div class="mb-5 rounded-xl bg-brand-50 border border-brand-200 text-brand-800 px-4 py-3 text-sm font-medium">
            ✅ <%= success %>
        </div>
    <% } %>

    <form method="POST" action="/booking" class="space-y-4" autocomplete="off"
        x-data="{ serviceType: '<%= old.service_type || '' %>', otherService: '<%= old.service_type_other || '' %>', propertySize: '<%= old.property_size || '' %>', otherPropertySize: '<%= old.property_size_other || '' %>' }">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Full Name</label>
                <input type="text" name="name" value="<%= old.name || '' %>" required autocomplete="off"
                    class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                <% if (errors.name) { %><p class="text-xs text-red-500 mt-1"><%= errors.name %></p><% } %>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Phone</label>
                <input type="text" name="phone" value="<%= old.phone || '' %>" required autocomplete="off"
                    class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                <% if (errors.phone) { %><p class="text-xs text-red-500 mt-1"><%= errors.phone %></p><% } %>
            </div>
        </div>

        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Email Address</label>
            <input type="email" name="email" value="<%= old.email || '' %>" required autocomplete="off"
                class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
            <% if (errors.email) { %><p class="text-xs text-red-500 mt-1"><%= errors.email %></p><% } %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Suburb</label>
                <input type="text" name="suburb" value="<%= old.suburb || '' %>" placeholder="e.g. Newcastle, NSW" required autocomplete="off"
                    class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                <% if (errors.suburb) { %><p class="text-xs text-red-500 mt-1"><%= errors.suburb %></p><% } %>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Service Needed</label>
                <select x-model="serviceType" required class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                    <option value="">Select a service</option>
                    <option>Regular House Cleaning</option>
                    <option>Deep Cleaning</option>
                    <option>End of Lease Cleaning</option>
                    <option>Carpet & Upholstery Cleaning</option>
                    <option>Office & Commercial Cleaning</option>
                    <option>NDIS Cleaning</option>
                    <option>School Cleaning</option>
                    <option>Laundry Service</option>
                    <option>Others</option>
                </select>
                <input type="text" x-show="serviceType === 'Others'" x-cloak x-model="otherService"
                    :required="serviceType === 'Others'" placeholder="Please specify the service you need" autocomplete="off"
                    class="w-full mt-2 rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                <input type="hidden" name="service_type" :value="serviceType === 'Others' ? otherService : serviceType">
                <% if (errors.service_type) { %><p class="text-xs text-red-500 mt-1"><%= errors.service_type %></p><% } %>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Property Size</label>
                <select x-model="propertySize" class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                    <option value="">Select size</option>
                    <option>Studio / 1 Bedroom</option>
                    <option>2 Bedroom</option>
                    <option>3 Bedroom</option>
                    <option>4+ Bedroom</option>
                    <option>Office / Commercial</option>
                    <option>Others</option>
                </select>
                <input type="text" x-show="propertySize === 'Others'" x-cloak x-model="otherPropertySize"
                    :required="propertySize === 'Others'" placeholder="Please specify the property size" autocomplete="off"
                    class="w-full mt-2 rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                <input type="hidden" name="property_size" :value="propertySize === 'Others' ? otherPropertySize : propertySize">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Preferred Date</label>
                <input type="date" name="preferred_date" value="<%= old.preferred_date || '' %>"
                    class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
            </div>
        </div>

        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Additional Details</label>
            <textarea name="message" rows="3" placeholder="Tell us anything else about your cleaning needs..."
                class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm"><%= old.message || '' %></textarea>
        </div>

        <button type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-brand-500 to-brand-700 px-6 py-3.5 text-white font-bold shadow-soft hover:shadow-lg hover:-translate-y-0.5 transition">
            Get My Free Quote →
        </button>
        <p class="text-xs text-center text-slate-400">No obligation. We reply within 1 business hour.</p>
    </form>
</div>
