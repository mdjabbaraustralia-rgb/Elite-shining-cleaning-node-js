<div>
    <label class="block text-sm font-semibold text-slate-700 mb-1">Label</label>
    <input type="text" name="label" value="<%= oldOr('label', image ? image.label : '') %>" required placeholder="e.g. Kitchen Deep Clean"
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
    <% if (errors.label) { %><p class="mt-1 text-xs text-red-500"><%= errors.label %></p><% } %>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Image</label>
    <% if (image && image.image) { %>
        <img src="<%= asset(image.image) %>" class="w-40 aspect-[4/3] object-cover rounded-xl border border-slate-100 mb-3">
    <% } %>
    <input type="file" name="image_upload" accept="image/*" <%= !image ? 'required' : '' %>
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
    <% if (image) { %><p class="mt-1 text-xs text-slate-400">Leave empty to keep the current image.</p><% } %>
    <% if (errors.image_upload) { %><p class="mt-1 text-xs text-red-500"><%= errors.image_upload %></p><% } %>
</div>

<div class="mt-6 grid sm:grid-cols-2 gap-6">
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Sort Order</label>
        <input type="number" name="sort_order" min="0" value="<%= oldOr('sort_order', image ? image.sort_order : 0) %>"
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
    </div>
    <div>
        <label class="block text-sm font-semibold text-transparent mb-1 select-none" aria-hidden="true">Published</label>
        <label class="flex items-center gap-2 text-sm text-slate-600 h-11">
            <input type="checkbox" name="is_published" value="1" <%= oldOr('is_published', image ? image.is_published : true) ? 'checked' : '' %>
                class="rounded border-slate-300 text-brand-600 focus:ring-brand-500">
            Published (visible on site)
        </label>
    </div>
</div>

<div class="mt-8 flex items-center gap-3">
    <button type="submit" class="rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-6 py-3 transition">Save Image</button>
    <a href="/admin/gallery" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
</div>
