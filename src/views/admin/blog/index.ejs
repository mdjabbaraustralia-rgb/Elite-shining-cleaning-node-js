<%- include('../partials/header', { title: 'Blog Posts', pageTitle: 'Blog Posts' }) %>
    <div class="mb-6 flex justify-end">
        <a href="/admin/blog/create" class="rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-5 py-2.5 transition">+ Add Post</a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">
        <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[800px]">
            <thead class="bg-slate-50 text-slate-500 text-left">
                <tr>
                    <th class="px-6 py-3 font-medium">Order</th>
                    <th class="px-6 py-3 font-medium">Image</th>
                    <th class="px-6 py-3 font-medium">Title</th>
                    <th class="px-6 py-3 font-medium">Tag</th>
                    <th class="px-6 py-3 font-medium">Date</th>
                    <th class="px-6 py-3 font-medium">Status</th>
                    <th class="px-6 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (posts.length === 0) { %>
                    <tr><td colspan="7" class="px-6 py-10 text-center text-slate-400">No blog posts yet.</td></tr>
                <% } %>
                <% posts.forEach(function (post) { %>
                    <tr class="hover:bg-slate-50">
                        <td class="px-6 py-4 text-slate-400"><%= post.sort_order %></td>
                        <td class="px-6 py-4">
                            <% if (post.image) { %>
                                <img src="<%= asset(post.image) %>" class="w-14 h-10 object-cover rounded-lg border border-slate-100">
                            <% } else { %>
                                <span class="text-slate-300 text-xs">No image</span>
                            <% } %>
                        </td>
                        <td class="px-6 py-4 font-semibold text-slate-900 max-w-xs truncate"><%= post.title %></td>
                        <td class="px-6 py-4 text-slate-500"><%= post.tag %></td>
                        <td class="px-6 py-4 text-slate-400"><%= formatDate(post.published_date) %></td>
                        <td class="px-6 py-4">
                            <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= post.is_published ? 'bg-brand-100 text-brand-700' : 'bg-slate-100 text-slate-500' %>">
                                <%= post.is_published ? 'Published' : 'Hidden' %>
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right space-x-3 whitespace-nowrap">
                            <a href="/admin/blog/<%= post.id %>/edit" class="text-brand-600 hover:underline font-semibold">Edit</a>
                            <form method="POST" action="/admin/blog/<%= post.id %>" class="inline" onsubmit="return confirm('Delete this post?');">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="text-red-500 hover:underline font-semibold">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        </div>
    </div>
<%- include('../partials/footer') %>
