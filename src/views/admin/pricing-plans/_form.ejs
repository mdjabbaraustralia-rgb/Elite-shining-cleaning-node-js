<div class="grid sm:grid-cols-2 gap-6">
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Plan Name</label>
        <input type="text" name="name" value="<%= oldOr('name', plan ? plan.name : '') %>" required
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <% if (errors.name) { %><p class="mt-1 text-xs text-red-500"><%= errors.name %></p><% } %>
    </div>
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Tagline</label>
        <input type="text" name="tagline" value="<%= oldOr('tagline', plan ? plan.tagline : '') %>" required
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <% if (errors.tagline) { %><p class="mt-1 text-xs text-red-500"><%= errors.tagline %></p><% } %>
    </div>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Features (one per line)</label>
    <textarea name="features" rows="5"
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm"><%= oldOr('features', plan ? plan.features : '') %></textarea>
    <% if (errors.features) { %><p class="mt-1 text-xs text-red-500"><%= errors.features %></p><% } %>
</div>

<div class="mt-6 grid sm:grid-cols-3 gap-6">
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Sort Order</label>
        <input type="number" name="sort_order" min="0" value="<%= oldOr('sort_order', plan ? plan.sort_order : 0) %>"
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
    </div>
    <div>
        <label class="block text-sm font-semibold text-transparent mb-1 select-none" aria-hidden="true">Popular</label>
        <label class="flex items-center gap-2 text-sm text-slate-600 h-11">
            <input type="checkbox" name="is_popular" value="1" <%= oldOr('is_popular', plan ? plan.is_popular : false) ? 'checked' : '' %>
                class="rounded border-slate-300 text-brand-600 focus:ring-brand-500">
            Mark as "Most Popular"
        </label>
    </div>
    <div>
        <label class="block text-sm font-semibold text-transparent mb-1 select-none" aria-hidden="true">Published</label>
        <label class="flex items-center gap-2 text-sm text-slate-600 h-11">
            <input type="checkbox" name="is_published" value="1" <%= oldOr('is_published', plan ? plan.is_published : true) ? 'checked' : '' %>
                class="rounded border-slate-300 text-brand-600 focus:ring-brand-500">
            Published (visible on site)
        </label>
    </div>
</div>

<div class="mt-8 flex items-center gap-3">
    <button type="submit" class="rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-6 py-3 transition">Save Plan</button>
    <a href="/admin/pricing-plans" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
</div>
