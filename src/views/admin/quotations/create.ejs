<%- include('../partials/header', { title: 'New Quotation', pageTitle: 'New Quotation' }) %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6 sm:p-8 max-w-3xl"
        x-data="{
            items: [{ description: '', quantity: 1, unit_price: 0 }],
            discountType: '<%= oldOr('discount_type', '') %>',
            discountValue: <%= oldOr('discount_value', 0) %>,
            addItem() { this.items.push({ description: '', quantity: 1, unit_price: 0 }) },
            removeItem(i) { if (this.items.length > 1) this.items.splice(i, 1) },
            subtotal() { return this.items.reduce((sum, item) => sum + (Number(item.quantity) || 0) * (Number(item.unit_price) || 0), 0) },
            discountAmount() {
                const value = Number(this.discountValue) || 0;
                if (!this.discountType || value <= 0) return 0;
                if (this.discountType === 'percentage') return Math.min(this.subtotal() * (value / 100), this.subtotal());
                return Math.min(value, this.subtotal());
            },
            total() { return (this.subtotal() - this.discountAmount()).toFixed(2) }
        }">
        <form method="POST" action="/admin/quotations">

            <% if (booking) { %>
                <input type="hidden" name="booking_id" value="<%= booking.id %>">
                <div class="mb-6 rounded-xl bg-brand-50 border border-brand-200 text-brand-800 px-4 py-3 text-sm">
                    Pre-filled from quote request <strong>#<%= booking.id %></strong> (<%= booking.name %>)
                </div>
            <% } %>

            <div class="grid sm:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Quote Number</label>
                    <input type="text" name="quote_number" value="<%= oldOr('quote_number', quoteNumber) %>" required
                        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                    <% if (errors.quote_number) { %><p class="mt-1 text-xs text-red-500"><%= errors.quote_number %></p><% } %>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Valid Until</label>
                    <input type="date" name="valid_until" value="<%= oldOr('valid_until', defaultValidUntil) %>"
                        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                </div>
            </div>

            <div class="mt-6 grid sm:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Client Name</label>
                    <input type="text" name="client_name" value="<%= oldOr('client_name', booking ? booking.name : '') %>" required
                        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                    <% if (errors.client_name) { %><p class="mt-1 text-xs text-red-500"><%= errors.client_name %></p><% } %>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Service Type</label>
                    <input type="text" name="service_type" value="<%= oldOr('service_type', booking ? booking.service_type : '') %>"
                        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Email</label>
                    <input type="email" name="client_email" value="<%= oldOr('client_email', booking ? booking.email : '') %>"
                        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Phone</label>
                    <input type="text" name="client_phone" value="<%= oldOr('client_phone', booking ? booking.phone : '') %>"
                        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Address / Suburb</label>
                    <input type="text" name="client_address" value="<%= oldOr('client_address', booking ? booking.suburb : '') %>"
                        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                </div>
            </div>

            <div class="mt-8">
                <label class="block text-sm font-semibold text-slate-700 mb-3">Line Items</label>

                <div class="hidden sm:grid grid-cols-12 gap-3 text-xs font-semibold text-slate-400 px-1 mb-2">
                    <div class="col-span-6">Description</div>
                    <div class="col-span-2">Qty</div>
                    <div class="col-span-3">Unit Price ($)</div>
                    <div class="col-span-1"></div>
                </div>

                <template x-for="(item, i) in items" :key="i">
                    <div class="grid grid-cols-12 gap-3 mb-3 items-start">
                        <div class="col-span-12 sm:col-span-6">
                            <input type="text" :name="'item_description[' + i + ']'" x-model="item.description" required placeholder="e.g. End of Lease Clean — 2 Bedroom"
                                class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                        </div>
                        <div class="col-span-4 sm:col-span-2">
                            <input type="number" :name="'item_quantity[' + i + ']'" x-model="item.quantity" min="0" step="1" required
                                class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                        </div>
                        <div class="col-span-6 sm:col-span-3">
                            <input type="number" :name="'item_price[' + i + ']'" x-model="item.unit_price" min="0" step="0.01" required
                                class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
                        </div>
                        <div class="col-span-2 sm:col-span-1 flex items-center h-11">
                            <button type="button" @click="removeItem(i)" class="text-red-400 hover:text-red-600 text-sm font-bold">✕</button>
                        </div>
                    </div>
                </template>

                <button type="button" @click="addItem()" class="text-sm font-semibold text-brand-600 hover:underline">+ Add line item</button>

                <div class="mt-6 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 border-t border-slate-100 pt-6">
                    <div class="sm:w-72">
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Discount (optional)</label>
                        <div class="flex gap-2">
                            <select name="discount_type" x-model="discountType" class="w-1/2 rounded-none border-slate-200 px-3 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm text-sm">
                                <option value="">No discount</option>
                                <option value="percentage">Percentage (%)</option>
                                <option value="fixed">Fixed Amount ($)</option>
                            </select>
                            <input type="number" name="discount_value" x-model="discountValue" x-show="discountType" x-cloak min="0" :max="discountType === 'percentage' ? 100 : null" step="0.01"
                                :placeholder="discountType === 'percentage' ? 'e.g. 10' : 'e.g. 50'"
                                class="w-1/2 rounded-none border-slate-200 px-3 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm text-sm">
                        </div>
                        <% if (errors.discount_value) { %><p class="mt-1 text-xs text-red-500"><%= errors.discount_value %></p><% } %>
                    </div>

                    <div class="text-right space-y-1">
                        <p class="text-sm text-slate-500">Subtotal: <span class="font-semibold text-slate-700">$<span x-text="subtotal().toFixed(2)"></span></span></p>
                        <p class="text-sm text-slate-500" x-show="discountAmount() > 0" x-cloak>
                            Discount: <span class="font-semibold text-red-500">-$<span x-text="discountAmount().toFixed(2)"></span></span>
                        </p>
                        <p class="text-xs text-slate-400 pt-1">Total</p>
                        <p class="font-display font-extrabold text-2xl text-brand-700">$<span x-text="total()"></span></p>
                    </div>
                </div>
            </div>

            <div class="mt-6">
                <label class="block text-sm font-semibold text-slate-700 mb-1">Notes / Terms (optional)</label>
                <textarea name="notes" rows="3" placeholder="e.g. Price includes all products and equipment. Payment due on completion."
                    class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm"><%= oldOr('notes', '') %></textarea>
            </div>

            <div class="mt-8 flex items-center gap-3">
                <button type="submit" class="rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-6 py-3 transition">Generate PDF Quotation</button>
                <a href="/admin/quotations" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
            </div>
        </form>
    </div>
<%- include('../partials/footer') %>
