<div class="grid sm:grid-cols-2 gap-6">
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Customer Name</label>
        <input type="text" name="name" value="<%= oldOr('name', testimonial ? testimonial.name : '') %>" required
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <% if (errors.name) { %><p class="mt-1 text-xs text-red-500"><%= errors.name %></p><% } %>
    </div>
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Location</label>
        <input type="text" name="location" value="<%= oldOr('location', testimonial ? testimonial.location : '') %>" required placeholder="e.g. Newcastle, NSW"
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <% if (errors.location) { %><p class="mt-1 text-xs text-red-500"><%= errors.location %></p><% } %>
    </div>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Customer Photo (optional)</label>
    <div class="flex items-center gap-4">
        <% if (testimonial && testimonial.photo) { %>
            <img src="<%= asset(testimonial.photo) %>" class="w-16 h-16 rounded-full object-cover border border-slate-100 flex-shrink-0">
        <% } else { %>
            <div class="w-16 h-16 rounded-full bg-brand-100 text-brand-700 font-bold flex items-center justify-center flex-shrink-0 text-xl">
                <%= (testimonial && testimonial.name ? testimonial.name : '?').substring(0,1) %>
            </div>
        <% } %>
        <div class="flex-1">
            <input type="file" name="photo_upload" accept="image/*"
                class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
            <p class="mt-1 text-xs text-slate-400">Leave empty to keep the current photo, or show initials if none is set.</p>
        </div>
    </div>
    <% if (errors.photo_upload) { %><p class="mt-1 text-xs text-red-500"><%= errors.photo_upload %></p><% } %>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Quote</label>
    <textarea name="quote" rows="4" required
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm"><%= oldOr('quote', testimonial ? testimonial.quote : '') %></textarea>
    <% if (errors.quote) { %><p class="mt-1 text-xs text-red-500"><%= errors.quote %></p><% } %>
</div>

<div class="mt-6 grid sm:grid-cols-3 gap-6">
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Rating (1-5)</label>
        <input type="number" name="rating" min="1" max="5" value="<%= oldOr('rating', testimonial ? testimonial.rating : 5) %>" required
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <% if (errors.rating) { %><p class="mt-1 text-xs text-red-500"><%= errors.rating %></p><% } %>
    </div>
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Sort Order</label>
        <input type="number" name="sort_order" min="0" value="<%= oldOr('sort_order', testimonial ? testimonial.sort_order : 0) %>"
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <p class="mt-1 text-xs text-slate-400">Lower numbers show first.</p>
    </div>
    <div>
        <label class="block text-sm font-semibold text-transparent mb-1 select-none" aria-hidden="true">Published</label>
        <label class="flex items-center gap-2 text-sm text-slate-600 h-11">
            <input type="checkbox" name="is_published" value="1" <%= oldOr('is_published', testimonial ? testimonial.is_published : true) ? 'checked' : '' %>
                class="rounded border-slate-300 text-brand-600 focus:ring-brand-500">
            Published (visible on site)
        </label>
    </div>
</div>

<div class="mt-8 flex items-center gap-3">
    <button type="submit" class="rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-6 py-3 transition">Save Testimonial</button>
    <a href="/admin/testimonials" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
</div>
