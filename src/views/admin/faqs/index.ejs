<%- include('../partials/header', { title: 'FAQs', pageTitle: 'FAQs' }) %>
    <div class="mb-6 flex justify-end">
        <a href="/admin/faqs/create" class="rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-5 py-2.5 transition">+ Add FAQ</a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">
        <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[760px]">
            <thead class="bg-slate-50 text-slate-500 text-left">
                <tr>
                    <th class="px-6 py-3 font-medium">Order</th>
                    <th class="px-6 py-3 font-medium">Question</th>
                    <th class="px-6 py-3 font-medium">Answer</th>
                    <th class="px-6 py-3 font-medium">Status</th>
                    <th class="px-6 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (faqs.length === 0) { %>
                    <tr><td colspan="5" class="px-6 py-10 text-center text-slate-400">No FAQs yet.</td></tr>
                <% } %>
                <% faqs.forEach(function (faq) { %>
                    <tr class="hover:bg-slate-50">
                        <td class="px-6 py-4 text-slate-400"><%= faq.sort_order %></td>
                        <td class="px-6 py-4 font-semibold text-slate-900 max-w-xs"><%= faq.question %></td>
                        <td class="px-6 py-4 text-slate-500 max-w-sm truncate"><%= faq.answer %></td>
                        <td class="px-6 py-4">
                            <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= faq.is_published ? 'bg-brand-100 text-brand-700' : 'bg-slate-100 text-slate-500' %>">
                                <%= faq.is_published ? 'Published' : 'Hidden' %>
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right space-x-3 whitespace-nowrap">
                            <a href="/admin/faqs/<%= faq.id %>/edit" class="text-brand-600 hover:underline font-semibold">Edit</a>
                            <form method="POST" action="/admin/faqs/<%= faq.id %>" class="inline" onsubmit="return confirm('Delete this FAQ?');">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="text-red-500 hover:underline font-semibold">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        </div>
    </div>
<%- include('../partials/footer') %>
