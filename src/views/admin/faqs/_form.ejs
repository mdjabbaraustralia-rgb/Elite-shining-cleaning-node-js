<div>
    <label class="block text-sm font-semibold text-slate-700 mb-1">Question</label>
    <input type="text" name="question" value="<%= oldOr('question', faq ? faq.question : '') %>" required
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
    <% if (errors.question) { %><p class="mt-1 text-xs text-red-500"><%= errors.question %></p><% } %>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Answer</label>
    <textarea name="answer" rows="4" required
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm"><%= oldOr('answer', faq ? faq.answer : '') %></textarea>
    <% if (errors.answer) { %><p class="mt-1 text-xs text-red-500"><%= errors.answer %></p><% } %>
</div>

<div class="mt-6 grid sm:grid-cols-2 gap-6">
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Sort Order</label>
        <input type="number" name="sort_order" min="0" value="<%= oldOr('sort_order', faq ? faq.sort_order : 0) %>"
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <p class="mt-1 text-xs text-slate-400">Lower numbers show first.</p>
    </div>
    <div>
        <label class="block text-sm font-semibold text-transparent mb-1 select-none" aria-hidden="true">Published</label>
        <label class="flex items-center gap-2 text-sm text-slate-600 h-11">
            <input type="checkbox" name="is_published" value="1" <%= oldOr('is_published', faq ? faq.is_published : true) ? 'checked' : '' %>
                class="rounded border-slate-300 text-brand-600 focus:ring-brand-500">
            Published (visible on site)
        </label>
    </div>
</div>

<div class="mt-8 flex items-center gap-3">
    <button type="submit" class="rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-6 py-3 transition">Save FAQ</button>
    <a href="/admin/faqs" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
</div>
