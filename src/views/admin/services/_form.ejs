<div class="grid sm:grid-cols-2 gap-6">
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Icon (emoji)</label>
        <input type="text" name="icon" value="<%= oldOr('icon', service ? service.icon : '') %>" placeholder="🏠"
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <p class="mt-1 text-xs text-slate-400">Shown on the homepage services grid.</p>
        <% if (errors.icon) { %><p class="mt-1 text-xs text-red-500"><%= errors.icon %></p><% } %>
    </div>
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Badge Text</label>
        <input type="text" name="badge_text" value="<%= oldOr('badge_text', service ? service.badge_text : '') %>" placeholder="e.g. 100% Bond-Back"
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <p class="mt-1 text-xs text-slate-400">Shown as the "Why it works" callout on the services page.</p>
        <% if (errors.badge_text) { %><p class="mt-1 text-xs text-red-500"><%= errors.badge_text %></p><% } %>
    </div>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Title</label>
    <input type="text" name="title" value="<%= oldOr('title', service ? service.title : '') %>" required
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
    <% if (errors.title) { %><p class="mt-1 text-xs text-red-500"><%= errors.title %></p><% } %>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Short Description</label>
    <input type="text" name="short_description" value="<%= oldOr('short_description', service ? service.short_description : '') %>" required
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
    <p class="mt-1 text-xs text-slate-400">Shown on the homepage services grid card.</p>
    <% if (errors.short_description) { %><p class="mt-1 text-xs text-red-500"><%= errors.short_description %></p><% } %>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Full Description</label>
    <textarea name="description" rows="3" required
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm"><%= oldOr('description', service ? service.description : '') %></textarea>
    <p class="mt-1 text-xs text-slate-400">Shown on the services page.</p>
    <% if (errors.description) { %><p class="mt-1 text-xs text-red-500"><%= errors.description %></p><% } %>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Features (one per line)</label>
    <textarea name="features" rows="4"
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm"><%= oldOr('features', service ? service.features : '') %></textarea>
    <% if (errors.features) { %><p class="mt-1 text-xs text-red-500"><%= errors.features %></p><% } %>
</div>

<div class="mt-6">
    <label class="block text-sm font-semibold text-slate-700 mb-1">Image</label>
    <% if (service && service.image) { %>
        <img src="<%= asset(service.image) %>" class="w-40 aspect-video object-cover rounded-xl border border-slate-100 mb-3">
    <% } %>
    <input type="file" name="image_upload" accept="image/*"
        class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
    <p class="mt-1 text-xs text-slate-400">Shown on the services page. Leave empty to keep the current image.</p>
    <% if (errors.image_upload) { %><p class="mt-1 text-xs text-red-500"><%= errors.image_upload %></p><% } %>
</div>

<div class="mt-6 grid sm:grid-cols-2 gap-6">
    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Sort Order</label>
        <input type="number" name="sort_order" min="0" value="<%= oldOr('sort_order', service ? service.sort_order : 0) %>"
            class="w-full rounded-none border-slate-200 px-4 py-2.5 leading-normal focus:outline-none focus:border-slate-200 focus:ring-0 shadow-sm">
        <p class="mt-1 text-xs text-slate-400">Lower numbers show first.</p>
    </div>
    <div>
        <label class="block text-sm font-semibold text-transparent mb-1 select-none" aria-hidden="true">Published</label>
        <label class="flex items-center gap-2 text-sm text-slate-600 h-11">
            <input type="checkbox" name="is_published" value="1" <%= oldOr('is_published', service ? service.is_published : true) ? 'checked' : '' %>
                class="rounded border-slate-300 text-brand-600 focus:ring-brand-500">
            Published (visible on site)
        </label>
    </div>
</div>

<div class="mt-8 flex items-center gap-3">
    <button type="submit" class="rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-6 py-3 transition">Save Service</button>
    <a href="/admin/services" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
</div>
