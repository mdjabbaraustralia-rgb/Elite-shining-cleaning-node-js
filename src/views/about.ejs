<%- include('partials/header', { title: 'About Us — Elite Shining Cleaning Australia' }) %>

<section class="relative overflow-hidden bg-brand-950 text-white py-20">
    <img src="<%= asset('images/hero-cleaning.jpg') %>" alt="" class="absolute inset-0 w-full h-full object-cover" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-800/90 via-brand-700/85 to-brand-950/95"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/20 px-4 py-1.5 text-sm font-medium">About Us</span>
        <h1 class="mt-5 font-display font-extrabold text-4xl sm:text-5xl"><%= setting('about_title', 'A local team, obsessed with clean') %></h1>
        <p class="mt-5 text-brand-100 max-w-2xl mx-auto"><%= setting('about_subtitle', 'Founded in Newcastle, Elite Shining Cleaning has grown into a trusted name across the Hunter Region — built on reliability, respect and real results.') %></p>
    </div>
</section>

<section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-16 items-center">
        <div class="reveal rounded-[2.5rem] overflow-hidden shadow-soft hover-lift">
            <img src="<%= setting('about_team_photo') || asset('images/team-photo.jpg') %>" alt="Elite Shining Cleaning team" class="w-full h-full object-cover aspect-[4/3] hover:scale-105 transition-transform duration-700" loading="lazy">
        </div>
        <div class="reveal reveal-2">
            <span class="text-brand-600 font-semibold tracking-wide uppercase text-sm">Our Story</span>
            <h2 class="mt-3 font-display font-extrabold text-3xl text-slate-900"><%= setting('about_story_heading', 'From one home, to thousands') %></h2>
            <p class="mt-4 text-slate-500 leading-relaxed"><%= setting('about_story_para1', "Elite Shining Cleaning started in 2016 with a single cleaner and a simple promise: treat every home like it's our own. Today, our vetted team of 80+ professionals serve homes and businesses across Newcastle, Lake Macquarie, Maitland and the greater Hunter Region — within a 50km radius — without ever losing that personal touch.") %></p>
            <p class="mt-4 text-slate-500 leading-relaxed"><%= setting('about_story_para2', "We're proud to be a fully Australian-owned company, reinvesting in our local cleaning teams and communities.") %></p>
        </div>
    </div>
</section>

<section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-brand-600 font-semibold tracking-wide uppercase text-sm">Our Guarantees</span>
            <h2 class="mt-3 font-display font-extrabold text-3xl text-slate-900">Why homeowners trust us</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
            <% [
                ['badges/fully-insured.png','Fully Insured','Public liability insurance for total peace of mind.'],
                ['badges/trusted.png','Police-Checked','Every cleaner passes a national police check.'],
                ['badges/eco-friendly.png','Eco-Friendly','Non-toxic products safe for kids and pets.'],
                ['badges/money-back.png',"Bond-Back Guarantee","Free re-clean if your agent isn't satisfied."],
            ].forEach(function (row, i) { %>
                <div class="reveal reveal-<%= i + 1 %> group bg-white rounded-3xl p-8 shadow-card border border-slate-100 text-center hover:-translate-y-2 hover:shadow-soft hover:border-brand-200 transition-all duration-300">
                    <div class="w-32 h-32 mx-auto flex items-center justify-center group-hover:scale-110 transition-all duration-300">
                        <img src="<%= asset('images/' + row[0]) %>" alt="<%= row[1] %>" class="w-full h-full object-contain" loading="lazy">
                    </div>
                    <h3 class="mt-5 font-display font-bold text-slate-900"><%= row[1] %></h3>
                    <p class="mt-2 text-sm text-slate-500"><%= row[2] %></p>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        <% [
            ['1','9','Years in Business'],
            ['2','80+','Vetted Cleaners'],
            ['3','50km','Service Radius'],
            ['4','12k+','Happy Customers'],
        ].forEach(function (row, i) { %>
            <div class="reveal reveal-<%= i + 1 %> hover-lift cursor-default">
                <p class="count-up text-3xl font-display font-extrabold text-brand-700"><%= setting('about_stat_' + row[0] + '_num', row[1]) %></p>
                <p class="text-sm text-slate-500 mt-1"><%= setting('about_stat_' + row[0] + '_label', row[2]) %></p>
            </div>
        <% }) %>
    </div>
</section>

<%- include('partials/footer', { footerServices: footerServices }) %>
